# Tailor App Environment Configuration Example
# ===========================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env files with real credentials to version control

# App Configuration
APP_NAME=Tailor App
APP_VERSION=1.0.0
APP_ENVIRONMENT=development

# Database Configuration
DATABASE_NAME=tailor_app.db
DATABASE_VERSION=1
DATABASE_TIMEOUT=30

# API Configuration
API_BASE_URL=https://your-api-domain.com
API_TIMEOUT=30000
API_RETRY_COUNT=3

# Authentication Configuration  
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_EXPIRATION_TIME=86400
REFRESH_TOKEN_EXPIRATION_TIME=604800

# Google Authentication
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Facebook Authentication
FACEBOOK_APP_ID=your-facebook-app-id-here
FACEBOOK_APP_SECRET=your-facebook-app-secret-here

# Firebase Configuration (if using Firebase)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MESSAGING_SENDER_ID=your-firebase-sender-id

# Storage Configuration
MAX_IMAGE_SIZE_MB=5
MAX_IMAGES_PER_ORDER=10
IMAGE_UPLOAD_PATH=/uploads/images
BACKUP_INTERVAL_HOURS=24

# Payment Configuration
PAYMENT_GATEWAY_KEY=your-payment-gateway-key
PAYMENT_GATEWAY_SECRET=your-payment-gateway-secret
CURRENCY=INR
TAX_PERCENTAGE=18.0

# Notification Configuration
PUSH_NOTIFICATION_KEY=your-push-notification-key
EMAIL_SERVICE_KEY=your-email-service-key
SMS_SERVICE_KEY=your-sms-service-key

# Debug Configuration
ENABLE_DEBUG_LOGS=true
ENABLE_PERFORMANCE_LOGS=true
ENABLE_NETWORK_LOGS=true
LOG_LEVEL=0

# Feature Flags
ENABLE_GOOGLE_AUTH=true
ENABLE_FACEBOOK_AUTH=true
ENABLE_BIOMETRIC_AUTH=false
ENABLE_DARK_MODE=true
ENABLE_OFFLINE_MODE=true

# Business Configuration
DEFAULT_CURRENCY_SYMBOL=₹
DEFAULT_TAX_RATE=18.0
DEFAULT_ADVANCE_PERCENTAGE=50.0
MAX_CUSTOMERS_PER_TAILOR=1000
ORDER_STATUS_AUTO_UPDATE=true

# Security Configuration
ENCRYPTION_KEY=your-encryption-key-here
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Analytics Configuration
ANALYTICS_ENABLED=true
CRASH_REPORTING_ENABLED=true
PERFORMANCE_MONITORING_ENABLED=true

# Development Configuration (for development environment only)
DEV_MOCK_PAYMENTS=true
DEV_SKIP_EMAIL_VERIFICATION=false
DEV_USE_LOCAL_DATABASE=true
DEV_ENABLE_DEBUG_MENU=true