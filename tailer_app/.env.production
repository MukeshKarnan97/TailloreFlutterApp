# Production Environment Configuration
# ===================================

# App Configuration
APP_NAME=Tailor App
APP_VERSION=1.0.0
APP_ENVIRONMENT=production

# Database Configuration
DATABASE_NAME=tailor_app_prod.db
DATABASE_VERSION=1
DATABASE_TIMEOUT=15

# API Configuration
API_BASE_URL=https://api.tailorapp.com
API_TIMEOUT=20000
API_RETRY_COUNT=3

# Authentication Configuration  
JWT_SECRET_KEY=CHANGE-THIS-IN-PRODUCTION-SUPER-SECRET-KEY
JWT_EXPIRATION_TIME=43200
REFRESH_TOKEN_EXPIRATION_TIME=259200

# Google Authentication (Production)
GOOGLE_CLIENT_ID=your-prod-google-client-id
GOOGLE_CLIENT_SECRET=your-prod-google-client-secret

# Facebook Authentication (Production)
FACEBOOK_APP_ID=your-prod-facebook-app-id
FACEBOOK_APP_SECRET=your-prod-facebook-app-secret

# Firebase Configuration (Production)
FIREBASE_PROJECT_ID=tailor-app-prod
FIREBASE_API_KEY=your-prod-firebase-api-key
FIREBASE_APP_ID=your-prod-firebase-app-id
FIREBASE_MESSAGING_SENDER_ID=your-prod-firebase-sender-id

# Debug Configuration (Production - Minimal Logging)
ENABLE_DEBUG_LOGS=false
ENABLE_PERFORMANCE_LOGS=false
ENABLE_NETWORK_LOGS=false
LOG_LEVEL=3

# Feature Flags (Production - Stable Features Only)
ENABLE_GOOGLE_AUTH=true
ENABLE_FACEBOOK_AUTH=true
ENABLE_BIOMETRIC_AUTH=false
ENABLE_DARK_MODE=true
ENABLE_OFFLINE_MODE=true

# Development-Specific Configuration (Disabled for Production)
DEV_MOCK_PAYMENTS=false
DEV_SKIP_EMAIL_VERIFICATION=false
DEV_USE_LOCAL_DATABASE=false
DEV_ENABLE_DEBUG_MENU=false

# Security Configuration (Strict for Production)
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_DURATION_MINUTES=30

# Analytics Configuration (Enabled for Production)
ANALYTICS_ENABLED=true
CRASH_REPORTING_ENABLED=true
PERFORMANCE_MONITORING_ENABLED=true

# Production-Specific Settings
PAYMENT_GATEWAY_KEY=your-production-payment-gateway-key
PAYMENT_GATEWAY_SECRET=your-production-payment-gateway-secret
ENCRYPTION_KEY=your-production-encryption-key-super-secure