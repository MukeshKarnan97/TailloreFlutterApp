# Development Environment Configuration
# ===================================

# App Configuration
APP_NAME=Tailor App (Dev)
APP_VERSION=1.0.0-dev
APP_ENVIRONMENT=development

# Database Configuration
DATABASE_NAME=tailor_app_dev.db
DATABASE_VERSION=5
DATABASE_TIMEOUT=30

# API Configuration
API_BASE_URL=https://dev-api.tailorapp.com
API_TIMEOUT=60000
API_RETRY_COUNT=5

# Authentication Configuration  
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production
JWT_EXPIRATION_TIME=86400
REFRESH_TOKEN_EXPIRATION_TIME=604800

# Google Authentication (Development)
GOOGLE_CLIENT_ID=your-dev-google-client-id
GOOGLE_CLIENT_SECRET=your-dev-google-client-secret

# Facebook Authentication (Development)
FACEBOOK_APP_ID=your-dev-facebook-app-id
FACEBOOK_APP_SECRET=your-dev-facebook-app-secret

# Firebase Configuration (Development)
FIREBASE_PROJECT_ID=tailor-app-dev
FIREBASE_API_KEY=your-dev-firebase-api-key
FIREBASE_APP_ID=your-dev-firebase-app-id
FIREBASE_MESSAGING_SENDER_ID=your-dev-firebase-sender-id

# Debug Configuration (Development - Verbose Logging)
ENABLE_DEBUG_LOGS=true
ENABLE_PERFORMANCE_LOGS=true
ENABLE_NETWORK_LOGS=true
LOG_LEVEL=0

# Feature Flags (Development - All Features Enabled)
ENABLE_GOOGLE_AUTH=true
ENABLE_FACEBOOK_AUTH=true
ENABLE_BIOMETRIC_AUTH=true
ENABLE_DARK_MODE=true
ENABLE_OFFLINE_MODE=true

# Development-Specific Configuration
DEV_MOCK_PAYMENTS=true
DEV_SKIP_EMAIL_VERIFICATION=true
DEV_USE_LOCAL_DATABASE=true
DEV_ENABLE_DEBUG_MENU=true

# Security Configuration (Relaxed for Development)
SESSION_TIMEOUT_MINUTES=120
MAX_LOGIN_ATTEMPTS=10
LOCKOUT_DURATION_MINUTES=5

# Analytics Configuration (Disabled for Development)
ANALYTICS_ENABLED=false
CRASH_REPORTING_ENABLED=false
PERFORMANCE_MONITORING_ENABLED=true