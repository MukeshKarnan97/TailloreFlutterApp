# Splash Screen Environment Configuration
# =====================================

# Development Splash Configuration
SPLASH_DURATION_DEV=2000              # 2 seconds for faster development
SPLASH_BACKGROUND_COLOR_DEV=#667eea   # Development gradient start
SPLASH_SHOW_DEBUG_INFO=true           # Show debug info in development

# Production Splash Configuration  
SPLASH_DURATION_PROD=3000             # 3 seconds for production
SPLASH_BACKGROUND_COLOR_PROD=#667eea  # Production gradient start
SPLASH_SHOW_DEBUG_INFO=false          # Hide debug info in production

# Splash Animation Configuration
SPLASH_FADE_DURATION=1500             # Logo fade animation duration (ms)
SPLASH_SCALE_DURATION=1200            # Logo scale animation duration (ms)  
SPLASH_SHIMMER_DURATION=2000          # Shimmer animation duration (ms)
SPLASH_PROGRESS_ENABLED=true          # Show progress bar

# Splash Branding
SPLASH_APP_NAME_ANIMATION=true        # Animate app name
SPLASH_TAGLINE_ENABLED=true           # Show tagline
SPLASH_VERSION_INFO_ENABLED=true      # Show version in corner

# Splash Error Handling
SPLASH_ERROR_RETRY_ENABLED=true       # Allow retry on initialization failure
SPLASH_ERROR_DEBUG_INFO=true          # Show debug info in error screen (dev only)